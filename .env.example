# Application Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration (MySQL 8.4)
# When running inside Docker Compose: use DB_HOST=mysql, DB_PORT=3306
# When running locally on host machine: use DB_HOST=localhost, DB_PORT=3306 (or mapped port 3311)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=storage_user
DB_PASSWORD=storage_password
DB_NAME=storage_online
MYSQL_ROOT_PASSWORD=root_secure_password

# JWT Authentication (secret must be at least 32 characters)
JWT_SECRET=super_secret_jwt_key_with_at_least_32_characters_123456
JWT_EXPIRATION=24h

# File Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# AWS S3 Configuration (Optional - ready for future S3 integration)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=my-file-storage-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
